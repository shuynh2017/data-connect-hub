
#!/bin/bash
#
echo "--- rosa.env ---"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
#export KUBECONFIG=~/sup/cluster-cfg/rosa-cluster.cfg
export KUBECONFIG=$SCRIPT_DIR/rosa-cluster.cfg
echo KUBECONFIG=$KUBECONFIG
export HTTPS_PROXY=
export HTTP_PROXY=

oc project
kubectl config current-context
