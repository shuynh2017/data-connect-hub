
import base64, os, tempfile

proto_dir = os.path.join(tempfile.gettempdir(), "flight-proto")
DCH_S3_PARQUET_QUERY = "datasets/dch-test-prompts.parquet"
DCH_SA_TOKEN="eyJhbGciOiJSUzI1NiIsImtpZCI6InA2NmxtWG5xbEtIaGMycW4xS2YteHlQY18zOG9CNUhPd1RyTjl3eGpCSjQifQ..PsNRWw2yaoZUA7YwHVf39L3NpwqbfSPs9QS6EWBDlgt3O-GvlbinnpDLOB4afcifStqCBxXSwPOPtG9xj26s4z0CdKSFJ0NLtpVzZhfXnQF9KR5CJ30zxD9VBB4WckvMlDKmtKlmknFUDDWLhktiI9qb5-iEyEMXpdtXwEHWKTZROqJ3bqSXPKOFIPv8gnMEaXwqW26xGJsI14tgN382ULrpGur2ugyoXqoiKDEFu4VFQK21HVW3ppivVt6idwWkpRhA9ZTHHV23tp5R-V4waCX9iArcBf0sVBAGmDjsXiZ_k5FgSFciJszGRg24mPPv4TXaCzrDsAWVQ87Qeot49odXhfO58TV5qPbQVmjAPAMXIc-s8rQHOErIUEtwcUXYk5mGywQWkGAJOdTXOP4o0J2GMHJ-3ns5-UX48Nw8SWqKM6PWfXEtP8sWD0pi21ZjJ5Rg4CwjQ0dvo8fc0USg7msytVrymdPVNqHNc3TBJ9S3nKyG7ICcMHaEa3kT40LvMTrg2W6FzO0q05Zqxfpl777nIhmZgQZ855YXYqGOLLLcK8Br3DkBMOUL2M9DUutZjTZS8kO4cQksKQu4yI7X12_4cBM1Zvoorp0nuXO84G-OoQY0NV-QV7zXVV80ivnyyLm-Z62yeqLvrzMQqRC01Ni5IFnIUFSduzkhk6YKmAo"
DCH_TENANT_NAMESPACE="dch-example"
DCH_S3_CONN_ID="0f48f652-3470-4f7e-986c-13a0aee7fa3f"
DCH_FLIGHT_SERVICE_PORT=15051

# Build the serialized FlightDescriptor.cmd bytes for S3 Parquet query
query_str = DCH_S3_PARQUET_QUERY.encode()
csq = b'\x0a' + bytes([len(query_str)]) + query_str

type_url = b"type.googleapis.com/arrow.flight.protocol.sql.CommandStatementQuery"
any_msg = b'\x0a' + bytes([len(type_url)]) + type_url + b'\x12' + bytes([len(csq)]) + csq

cmd_b64 = base64.b64encode(any_msg).decode()

cmd = f"""grpcurl -insecure \\
    -proto Flight.proto \\
    -H "authorization: Bearer {DCH_SA_TOKEN}" \\
    -H "x-tenant-id: {DCH_TENANT_NAMESPACE}" \\
    -H "x-data-connection-id: {DCH_S3_CONN_ID}" \\
    -d '{{"type":"CMD","cmd":"{cmd_b64}"}}' \\
    127.0.0.1:{DCH_FLIGHT_SERVICE_PORT} \\
    arrow.flight.protocol.FlightService/GetFlightInfo"""

print("=== GetFlightInfo via grpcurl (S3 Parquet) ===")
print(f"S3 path: {DCH_S3_PARQUET_QUERY}")
print(f"(run from {proto_dir})\n")
print(f"$ {cmd}\n")
